"ssh root connect"
ssh root@138.249.8.195

"Настройка убунты"
sudo apt update && sudo apt upgrade -y
sudo timedatectl set-timezone Europe/Moscow

"установите брандмауэр (UFW)"
sudo apt install ufw -y

"Конфигурация UFW: последовательное разрешение SSH"
sudo ufw allow ssh

"открытие порта прокси-сервера 3128" 
sudo ufw allow 3128/tc

"запуск межсетевого экрана"
sudo ufw enable

"Установка пакета Squid и набора утилит Apache для генерации защищенных паролей"
sudo apt install squid apache2-utils -y

"Создание дубликата исходного конфигурационного файла Squid перед внесением изменений"
sudo cp /etc/squid/squid.conf /etc/squid/squid.conf.bak

"Генерация файла скрытых паролей'92922700' и создание пользователя (замените 'proxy_user' на желаемое имя)"
sudo htpasswd -c /etc/squid/passwords NeuroKos

"Перезапуск системной службы Squid для загрузки новых правил" 
sudo systemctl restart squid

"добавление процесса в автозапуск операционной системы"
sudo systemctl enable squid

"Проверка текущего статуса работы демона Squid в системе"
sudo systemctl status squid


  "squid_config_file": {
